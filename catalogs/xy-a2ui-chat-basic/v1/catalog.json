{
  "format": "xy-a2ui-component-catalog",
  "catalogId": "xy-a2ui-chat-basic",
  "catalogVersion": "1.1.0",
  "protocolVersion": "v0.9",
  "profile": "xy-a2ui-chat",
  "description": "XyAgenUI 对话回复使用的 v1 布局、基础展示与选择交互组件。",
  "runtimeCatalogId": "ohos.a2ui.extended.catalog.form",
  "rendererContract": "实现合同见 references/a2ui/renderer-contract.md；协议 catalogId 由对话 profile 固定，按 catalog 路由的宿主必须映射到 Chat v1 Extended registry。",
  "components": {
    "Extended.Card": {
      "category": "layout",
      "required": ["id", "component", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.Card" },
        "children": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "width": { "oneOf": [{ "type": "number" }, { "type": "string", "enum": ["matchParent"] }] },
        "height": { "oneOf": [{ "type": "number" }, { "type": "string", "enum": ["matchParent"] }] },
        "fill": { "type": "string" },
        "strokeThickness": { "oneOf": [{ "type": "number" }, { "type": "object", "properties": { "top": { "type": "number" }, "right": { "type": "number" }, "bottom": { "type": "number" }, "left": { "type": "number" } }, "additionalProperties": false }] },
        "strokeColor": { "type": "string" },
        "layout": { "type": "string", "enum": ["vertical", "horizontal"] },
        "justifyContent": { "type": "string", "enum": ["flex_start", "center", "flex_end", "space_between", "space_around"] },
        "alignItems": { "type": "string", "enum": ["flex_start", "center", "flex_end", "stretch"] },
        "gap": { "type": "number", "minimum": 0 },
        "padding": { "oneOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 4 }, { "$ref": "#/definitions/edgeInsets" }] },
        "radius": { "oneOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }] },
        "backgroundImage": { "type": "string", "minLength": 1 },
        "backgroundBlendMode": { "type": "string" },
        "backgroundPosition": { "type": "string" },
        "backgroundSize": { "type": "string" },
        "styles": { "$ref": "#/definitions/cardStyles" }
      },
      "additionalProperties": false
    },
    "Extended.Row": {
      "category": "layout",
      "required": ["id", "component", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.Row" },
        "children": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "space": { "type": "number", "minimum": 0 },
        "styles": { "$ref": "#/definitions/rowColumnStyles" }
      },
      "additionalProperties": false
    },
    "Extended.Column": {
      "category": "layout",
      "required": ["id", "component", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.Column" },
        "children": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "space": { "type": "number", "minimum": 0 },
        "styles": { "$ref": "#/definitions/rowColumnStyles" }
      },
      "additionalProperties": false
    },
    "Extended.Stack": {
      "category": "layout",
      "required": ["id", "component", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.Stack" },
        "children": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "styles": { "$ref": "#/definitions/stackStyles" }
      },
      "additionalProperties": false
    },
    "Extended.Text": {
      "category": "basic",
      "required": ["id", "component", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.Text" },
        "content": { "type": "string" },
        "styles": { "$ref": "#/definitions/textStyles" }
      },
      "additionalProperties": false
    },
    "Extended.Image": {
      "category": "basic",
      "required": ["id", "component", "src"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.Image" },
        "src": { "type": "string", "minLength": 1 },
        "styles": { "$ref": "#/definitions/imageStyles" }
      },
      "additionalProperties": false
    },
    "Extended.Divider": {
      "category": "basic",
      "required": ["id", "component"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.Divider" },
        "styles": { "$ref": "#/definitions/dividerStyles" }
      },
      "additionalProperties": false
    },
    "Extended.ChoiceGroup": {
      "category": "input",
      "requiredCapability": "selection-query-v1",
      "required": ["id", "component", "label", "mode", "options"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.ChoiceGroup" },
        "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "mode": { "type": "string", "enum": ["single", "multiple"] },
        "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/choiceOption" } },
        "minSelected": { "type": "integer", "minimum": 1 },
        "maxSelected": { "type": "integer", "minimum": 1 },
        "styles": { "$ref": "#/definitions/cardStyles" }
      },
      "additionalProperties": false
    },
    "Extended.Button": {
      "category": "basic",
      "required": ["id", "component", "label", "enabled", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "component": { "const": "Extended.Button" },
        "label": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "action": { "$ref": "#/definitions/buttonAction" },
        "styles": { "$ref": "#/definitions/buttonStyles" }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "choiceOption": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "edgeInsets": {
      "type": "object",
      "properties": {
        "top": { "type": "number" },
        "right": { "type": "number" },
        "bottom": { "type": "number" },
        "left": { "type": "number" }
      },
      "additionalProperties": false
    },
    "radiusInsets": {
      "type": "object",
      "properties": {
        "topLeft": { "type": "number" },
        "topRight": { "type": "number" },
        "bottomRight": { "type": "number" },
        "bottomLeft": { "type": "number" }
      },
      "additionalProperties": false
    },
    "commonStyles": {
      "type": "object",
      "properties": {
        "width": { "oneOf": [{ "type": "number" }, { "type": "string", "enum": ["matchParent", "wrapContent"] }, { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?%$" }] },
        "height": { "oneOf": [{ "type": "number" }, { "type": "string", "enum": ["matchParent"] }, { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?%$" }] },
        "flexShrink": { "type": "number" },
        "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "minWidth": { "type": "number" },
        "minHeight": { "type": "number" },
        "maxWidth": { "type": "number" },
        "maxHeight": { "type": "number" },
        "margin": { "oneOf": [{ "type": "number" }, { "$ref": "#/definitions/edgeInsets" }] },
        "padding": { "oneOf": [{ "type": "number" }, { "$ref": "#/definitions/edgeInsets" }] },
        "borderRadius": { "oneOf": [{ "type": "number" }, { "$ref": "#/definitions/radiusInsets" }] },
        "visibility": { "type": "string", "enum": ["visible", "hidden", "none"] },
        "clip": { "type": "boolean" },
        "backgroundColor": { "type": "string" },
        "borderWidth": { "type": ["number", "string"] },
        "borderColor": { "type": "string" },
        "layoutWeight": { "type": "number" }
      }
    },
    "textStyles": {
      "allOf": [
        { "$ref": "#/definitions/commonStyles" },
        {
          "type": "object",
          "properties": {
            "textOverflow": { "type": "string", "enum": ["ellipsis", "clip", "marquee", "none"] },
            "decoration": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["none", "underline", "overline", "lineThrough"] },
                "color": { "type": "string" },
                "style": { "type": "string", "enum": ["solid", "doubleE", "dotted", "dashed", "wavy"] }
              },
              "additionalProperties": false
            },
            "fontSize": { "type": "number" },
            "fontWeight": { "type": ["string", "number"], "enum": ["300", "400", "500", "600", "700", 300, 400, 500, 700, 900] },
            "fontColor": { "type": "string" },
            "textAlign": { "type": "string", "enum": ["start", "center", "end", "justify"] },
            "maxLines": { "type": "integer", "minimum": 1 },
            "wordBreak": { "type": "string", "enum": ["normal", "breakAll", "breakWord", "hyphenation"] },
            "maxFontSize": { "type": "number" },
            "fontScaleMode": { "type": "string", "enum": ["followSystem", "custom"] },
            "minFontScale": { "type": "number" },
            "maxFontScale": { "type": "number" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rowColumnStyles": {
      "allOf": [
        { "$ref": "#/definitions/commonStyles" },
        {
          "type": "object",
          "properties": {
            "justifyContent": { "type": "string", "enum": ["start", "center", "end", "spaceBetween", "spaceAround", "spaceEvenly"] },
            "alignItems": { "type": "string", "enum": ["top", "center", "bottom"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stackStyles": {
      "allOf": [
        { "$ref": "#/definitions/commonStyles" },
        {
          "type": "object",
          "properties": {
            "alignContent": { "type": "string", "enum": ["topStart", "top", "topEnd", "start", "center", "end", "bottomStart", "bottom", "bottomEnd"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "imageStyles": {
      "allOf": [
        { "$ref": "#/definitions/commonStyles" },
        {
          "type": "object",
          "properties": {
            "objectFit": { "type": "string", "enum": ["fill", "contain", "cover", "auto", "none", "scaleDown", "topStart", "top", "topEnd", "start", "center", "end", "bottomStart", "bottom", "bottomEnd", "matrix"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dividerStyles": {
      "allOf": [
        { "$ref": "#/definitions/commonStyles" },
        {
          "type": "object",
          "properties": {
            "strokeWidth": { "type": "number", "minimum": 0 },
            "vertical": { "type": "boolean" },
            "color": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "buttonStyles": {
      "allOf": [
        { "$ref": "#/definitions/commonStyles" },
        {
          "type": "object",
          "properties": {
            "fontSize": { "type": "number" },
            "fontWeight": { "type": ["string", "number"], "enum": ["300", "400", "500", "600", "700", 100, 300, 400, 500, 700, 900] },
            "fontColor": { "type": "string" },
            "maxFontSize": { "type": "number" },
            "fontScaleMode": { "type": "string", "enum": ["followSystem", "custom"] },
            "minFontScale": { "type": "number" },
            "maxFontScale": { "type": "number" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "cardStyles": {
      "allOf": [{ "$ref": "#/definitions/commonStyles" }],
      "unevaluatedProperties": false
    },
    "buttonAction": {
      "type": "object",
      "properties": {
        "event": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "context": { "type": "object" }
          },
          "required": ["name", "context"],
          "additionalProperties": false
        }
      },
      "required": ["event"],
      "additionalProperties": false
    }
  }
}
